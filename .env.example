# Backend (read from this repo-root .env in local dev; set as env vars when deployed)
GEMINI_API_KEY=
# Free tier allows ~20 requests/day/model and no Pro models or web search; one board run = 12 requests.
CRUCIBLE_SEAT_MODEL=gemini-3.6-flash
CRUCIBLE_CHAIR_MODEL=gemini-3.6-flash
# true needs a billed key (Google Search grounding)
CRUCIBLE_WEB_SEARCH=false
# Comma-separated frontend origins allowed to call the API
CRUCIBLE_ALLOW_ORIGINS=http://localhost:5173
# Optional session store: sqlite:///sessions.db, postgresql://..., or memory://.
# Empty = ADK's local store under backend/agents/crucible/.adk/
CRUCIBLE_SESSION_DB=
