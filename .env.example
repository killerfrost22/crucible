# Backend (read from this repo-root .env in local dev; set as env vars when deployed)
# Models named openrouter/<provider>/<model> use OPENROUTER_API_KEY (prepaid credit = hard spend cap).
OPENROUTER_API_KEY=
# Optional: bare Gemini model names (e.g. gemini-3.5-flash-lite) call Google directly with this key.
GEMINI_API_KEY=

# One board run = 12 model calls, about $0.06–0.12 with these defaults.
CRUCIBLE_SEAT_MODEL=openrouter/anthropic/claude-haiku-5.5
CRUCIBLE_RESEARCHER_MODEL=openrouter/anthropic/claude-sonnet-5.5
CRUCIBLE_CHAIR_MODEL=openrouter/anthropic/claude-sonnet-5.5
# Optional per-seat overrides, e.g. a different company per seat:
# CRUCIBLE_REALIST_MODEL=openrouter/anthropic/claude-sonnet-5.5
# CRUCIBLE_AI_TOOLS_EXPERT_MODEL=openrouter/openai/gpt-5.6-luna
# CRUCIBLE_STRATEGIST_MODEL=openrouter/x-ai/grok-4.7
# CRUCIBLE_DEVILS_ADVOCATE_MODEL=openrouter/deepseek/deepseek-v4.1-flash
# CRUCIBLE_INDUSTRY_EXPERT_MODEL=openrouter/google/gemini-3.6-flash

# Researcher web search: OpenRouter's :online variant (~$0.007/search) or Gemini's Google Search.
CRUCIBLE_WEB_SEARCH=true
# Comma-separated frontend origins allowed to call the API
CRUCIBLE_ALLOW_ORIGINS=http://localhost:5173
# Optional session store: sqlite:///sessions.db, postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require, or memory://.
# Empty = ADK's local store under backend/agents/crucible/.adk/
CRUCIBLE_SESSION_DB=

# Request guard (backend/guard.py). Limits are in memory, per process; 0 disables a limit.
# Board runs per client IP in any 60 minutes, and new sessions per client IP in any 60 minutes:
# CRUCIBLE_RUNS_PER_IP_PER_HOUR=40
# CRUCIBLE_SESSIONS_PER_IP_PER_HOUR=60
# Board runs in any 24 hours across all clients, and runs streaming at once:
# CRUCIBLE_RUNS_PER_DAY=100
# CRUCIBLE_MAX_CONCURRENT_RUNS=3
# Request body cap in bytes:
# CRUCIBLE_MAX_BODY_BYTES=16384
# Where the client IP comes from. Empty = the socket peer (local dev). Deployed: x-forwarded-for on
# Cloud Run, x-vercel-forwarded-for on Vercel (see README → Deploy). HOP counts from the right, 1 = last.
# CRUCIBLE_CLIENT_IP_HEADER=
# CRUCIBLE_CLIENT_IP_HOP=1
